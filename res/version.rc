// exe 版本信息（右键 → 属性可见）。MSVC 经 app.rc 编入，MinGW 由 build.ps1 用 windres 单独编入。
// 发版流程：改这里 → 提交 → git tag vX.Y.Z → push tag（CI 自动发布 Release）。
// 注意：rc 源码保持 ASCII，避免 rc.exe / windres 代码页差异导致乱码。
#include <windows.h>
#include <winver.h>

#define VER_MAJOR 0
#define VER_MINOR 1
#define VER_PATCH 0

#define STR2(x) #x
#define STR(x) STR2(x)
#define VER_STR STR(VER_MAJOR) "." STR(VER_MINOR) "." STR(VER_PATCH)

VS_VERSION_INFO VERSIONINFO
 FILEVERSION VER_MAJOR,VER_MINOR,VER_PATCH,0
 PRODUCTVERSION VER_MAJOR,VER_MINOR,VER_PATCH,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "hai-season"
            VALUE "FileDescription", "IME state floating indicator"
            VALUE "FileVersion", VER_STR
            VALUE "InternalName", "ImeIndicator"
            VALUE "LegalCopyright", "Copyright (c) 2026 hai-season - MIT License"
            VALUE "OriginalFilename", "ImeIndicator.exe"
            VALUE "ProductName", "ImeIndicator"
            VALUE "ProductVersion", VER_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
